package ochrance-fs
version = 0.1.0
authors = "Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"
brief = "Ochránce Filesystem Module - Merkle tree verification and repair"
license = "MPL-2.0"
langversion >= 0.8.0

depends = ochrance

sourcedir = "modules"

modules = Ochrance.Filesystem.Types
        , Ochrance.Filesystem.Merkle
        , Ochrance.Filesystem.Verify
        , Ochrance.Filesystem.Repair

opts = "--total"
